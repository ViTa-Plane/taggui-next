/* ==========================================================================
   TagGUI Next - Global Qt Dark Theme & Dialog Stylesheet (.qss)
   ========================================================================== */

QDialog {
    background-color: #0b0c10;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QFrame#cardFrame {
    background-color: #12141c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

QLabel#titleLabel {
    color: #e2e8f0;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.05em;
}

QLabel#descLabel {
    color: #94a3b8;
    font-size: 11px;
    line-height: 1.4;
}

QLabel#statusLabel {
    color: #38bdf8;
    font-size: 11px;
    font-family: monospace;
}

QTextEdit#logOutput {
    background-color: #0d0e12;
    color: #a5b4fc;
    font-family: monospace;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #121318;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #2a2d3d;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #3d4259;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Buttons */
QPushButton {
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 14px;
}

QPushButton#cancelBtn {
    background-color: #181a24;
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.08);
}
QPushButton#cancelBtn:hover {
    background-color: #27272a;
    color: #ffffff;
}

QPushButton#confirmBtn, QPushButton#closeBtn:enabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4f46e5, stop:1 #7c3aed);
    color: #ffffff;
    border: none;
}
QPushButton#confirmBtn:hover, QPushButton#closeBtn:enabled:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6366f1, stop:1 #8b5cf6);
}

QPushButton#closeBtn {
    background-color: #181a24;
    color: #64748b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 7px 18px;
}

QPushButton#deleteBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ef4444, stop:1 #dc2626);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 14px;
}
QPushButton#deleteBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f87171, stop:1 #ef4444);
}