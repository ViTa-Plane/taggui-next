/* ==========================================================================
   TagGUI Next - Global Qt Dark Theme & Dialog Stylesheet (.qss)
   ========================================================================== */

QDialog {
    background-color: #0b0c10;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

QFrame#cardFrame {
    background-color: #12141c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

QLabel#titleLabel {
    color: #e2e8f0;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.05em;
}

QLabel#descLabel {
    color: #94a3b8;
    font-size: 11px;
}

QLabel#statusLabel {
    color: #38bdf8;
    font-size: 11px;
    font-family: monospace;
}

QTextEdit#logOutput {
    background-color: #0d0e12;
    color: #a5b4fc;
    font-family: monospace;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #121318;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #2a2d3d;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #3d4259;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    height: 0px;
}

/* Buttons */
QPushButton {
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 14px;
}

QPushButton#cancelBtn {
    background-color: #181a24;
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.08);
}
QPushButton#cancelBtn:hover {
    background-color: #27272a;
    color: #ffffff;
}

QPushButton#confirmBtn, QPushButton#closeBtn:enabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4f46e5, stop:1 #7c3aed);
    color: #ffffff;
    border: none;
}
QPushButton#confirmBtn:hover, QPushButton#closeBtn:enabled:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6366f1, stop:1 #8b5cf6);
}

QPushButton#closeBtn {
    background-color: #181a24;
    color: #64748b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 7px 18px;
}

QPushButton#deleteBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ef4444, stop:1 #dc2626);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 14px;
}
QPushButton#deleteBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f87171, stop:1 #ef4444);
}

/* ==========================================================================
   SettingsDialog Form Controls (Strictly Bounded)
   ========================================================================== */

SettingsDialog QGroupBox {
    color: #818cf8;
    font-size: 11px;
    font-weight: bold;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    margin-top: 8px;
    padding: 12px 8px 8px 8px;
    background-color: rgba(99, 102, 241, 0.04);
}

SettingsDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

SettingsDialog QLabel {
    color: #cbd5e1;
    font-size: 11px;
}

SettingsDialog QComboBox {
    background-color: #181a24;
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    max-width: 450px;
    min-width: 140px;
    max-height: 26px;
}

SettingsDialog QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
}

SettingsDialog QComboBox QAbstractItemView {
    background-color: #12141c;
    color: #e2e8f0;
    selection-background-color: #4f46e5;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

SettingsDialog QSpinBox {
    background-color: #181a24;
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 4px 18px 4px 8px;
    font-family: monospace;
    font-size: 11px;
    max-width: 400px;
    min-width: 70px;
    max-height: 26px;
}
SettingsDialog QSpinBox:focus {
    border: 1px solid #6366f1;
}

SettingsDialog QCheckBox {
    color: #cbd5e1;
    font-size: 11px;
    spacing: 8px;
}

SettingsDialog QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background-color: #181a24;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

SettingsDialog QCheckBox::indicator:checked {
    background-color: #4f46e5;
    border-color: #4f46e5;
}

SettingsDialog QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #181a24;
    border-radius: 2px;
}

SettingsDialog QSlider::sub-page:horizontal {
    background: #4f46e5;
    border-radius: 2px;
}

SettingsDialog QSlider::handle:horizontal {
    background: #ffffff;
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

SettingsDialog QSlider::handle:horizontal:hover {
    background: #38bdf8;
}

QWidget#scrollContent {
    background-color: #12141c;
}

/* ==========================================================================
   KeywordGroupsDialog Form Controls & Cards (Compact Padding)
   ========================================================================== */

QGroupBox#groupCardBox {
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    margin-top: 0px;
    margin-bottom: 0px;
    background-color: rgba(99, 102, 241, 0.04);
    padding: 0px 0px 0px 0px;
}

QLabel#groupTitleLabel {
    color: #818cf8;
    font-weight: bold;
    font-size: 11px;
}

QToolButton#groupDeleteBtn {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    font-size: 14px;
    font-weight: bold;
    border-radius: 4px;
    padding: 0px;
    line-height: 1;
    padding-bottom: 5px;
}

QToolButton#groupDeleteBtn:hover {
    background: rgba(239, 68, 68, 0.4);
    color: #ffffff;
}

QLineEdit#keywordLineEdit {
    background-color: #0d0e12;
    color: #a5b4fc;
    font-family: monospace;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 8px;
}

QLineEdit#keywordLineEdit:focus {
    border: 1px solid #6366f1;
}

/* Standard App-Wide Dialog Close Button */
QToolButton#dialogCloseBtn {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 16px;
    font-weight: bold;
}
QToolButton#dialogCloseBtn:hover {
    color: #ffffff;
}